# Production Environment Variables
# Copy this to .env.production and fill in your actual values
# DO NOT COMMIT .env.production to git!

# Database - Use connection pooling URL from Neon
# Format: postgresql://[user]:[password]@[host]/[database]?pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://user:password@host.neon.tech/flowshield?sslmode=require"

# NextAuth - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Your production domain
NEXTAUTH_URL="https://flowshield.app"
