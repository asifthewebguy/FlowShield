{
  "manifest_version": 3,
  "name": "FlowShield",
  "version": "1.0.0",
  "description": "Focus timer, activity tracking & distraction blocking. Works with your FlowShield dashboard across all devices.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png"
    },
    "default_title": "FlowShield"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "https://flowshield.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://flowshield.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
