<Window x:Class="FlowShield.Desktop.UI.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowShield Projects"
        Width="480" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F2937" Offset="0"/>
                <GradientStop Color="#111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Projects" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RefreshBtn" Content="↻" Width="32" Height="32"
                                Style="{StaticResource IconBtnStyle}"
                                Click="RefreshButton_Click" Margin="0,0,6,0"/>
                        <Button Content="✕" Width="32" Height="32"
                                Style="{StaticResource IconBtnStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="#1AFFFFFF" Margin="20,0"/>

            <!-- Projects list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16,20,8"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="EmptyText"
                               Text="No projects yet. Create one below!"
                               Foreground="#4B5563" FontSize="13" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Margin="0,20,0,0"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="ProjectsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" CornerRadius="10"
                                        Background="#0FFFFFFF" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Color swatch -->
                                        <Border Grid.Column="0" Width="14" Height="14"
                                                CornerRadius="7" Margin="0,0,12,0"
                                                Background="{Binding ColorBrush}"
                                                VerticalAlignment="Center"/>

                                        <!-- Name -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Foreground="White" FontSize="13"
                                                   FontFamily="Segoe UI" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>

                                        <!-- Session count -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SessionCountText}"
                                                   Foreground="#6B7280" FontSize="12"
                                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- New Project form -->
            <Border Grid.Row="2" Background="#0A000000" CornerRadius="0,0,20,20"
                    Margin="1,0,1,1" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="New Project" Foreground="#9CA3AF" FontSize="12"
                               FontFamily="Segoe UI" FontWeight="Medium" Margin="0,0,0,10"/>

                    <!-- Name input -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProjectNameBox" Grid.Column="0" Margin="0,0,8,0"
                                 Height="36"
                                 Background="#1F2937" Foreground="White"
                                 BorderBrush="#374151" BorderThickness="1"
                                 FontFamily="Segoe UI" FontSize="13"
                                 VerticalContentAlignment="Center" Padding="8,0"/>
                        <Button x:Name="CreateBtn" Grid.Column="1"
                                Content="Create" Height="36"
                                Style="{StaticResource PrimaryBtnStyle}"
                                Click="CreateProject_Click"/>
                    </Grid>

                    <!-- Color palette -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Color:" Foreground="#6B7280" FontSize="12"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="Color1" Width="20" Height="20" CornerRadius="10"
                                Background="#3B82F6" Cursor="Hand" Margin="0,0,6,0"
                                MouseLeftButtonDown="ColorSwatch_Click" Tag="#3b82f6"
                                BorderBrush="White" BorderThickness="2"/>
                        <Border x:Name="Color2" Width="20" Height="20" CornerRadius="10"
                                Background="#10B981" Cursor="Hand" Margin="0,0,6,0"
                                MouseLeftButtonDown="ColorSwatch_Click" Tag="#10b981"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <Border x:Name="Color3" Width="20" Height="20" CornerRadius="10"
                                Background="#F59E0B" Cursor="Hand" Margin="0,0,6,0"
                                MouseLeftButtonDown="ColorSwatch_Click" Tag="#f59e0b"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <Border x:Name="Color4" Width="20" Height="20" CornerRadius="10"
                                Background="#EF4444" Cursor="Hand" Margin="0,0,6,0"
                                MouseLeftButtonDown="ColorSwatch_Click" Tag="#ef4444"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <Border x:Name="Color5" Width="20" Height="20" CornerRadius="10"
                                Background="#8B5CF6" Cursor="Hand" Margin="0,0,6,0"
                                MouseLeftButtonDown="ColorSwatch_Click" Tag="#8b5cf6"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <Border x:Name="Color6" Width="20" Height="20" CornerRadius="10"
                                Background="#EC4899" Cursor="Hand"
                                MouseLeftButtonDown="ColorSwatch_Click" Tag="#ec4899"
                                BorderBrush="Transparent" BorderThickness="2"/>
                    </StackPanel>

                    <TextBlock x:Name="ProjectStatusText" Foreground="#10B981"
                               FontSize="12" FontFamily="Segoe UI"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
