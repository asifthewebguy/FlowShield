<Window x:Class="FlowShield.Desktop.UI.CoachWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowShield AI Coach"
        Width="500" Height="620"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#111827"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F2937" Offset="0"/>
                <GradientStop Color="#111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AI Coach" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="Powered by Claude" Foreground="#4B5563" FontSize="11"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,1,0,0"/>
                    </StackPanel>
                    <Button Content="✕" Width="32" Height="32"
                            Style="{StaticResource IconBtnStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="#1AFFFFFF" Margin="20,0"/>

            <!-- Chat history -->
            <ScrollViewer x:Name="ChatScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,0" Padding="20,16,20,8">
                <StackPanel>
                    <!-- Welcome message -->
                    <Border HorizontalAlignment="Left" MaxWidth="360" Margin="0,0,0,12"
                            Background="#0F3B82F6" CornerRadius="12,12,12,4" Padding="12,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="20" Height="20" CornerRadius="10"
                                        Background="#3B82F6" Margin="0,0,6,0">
                                    <TextBlock Text="✨" FontSize="10" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Coach" Foreground="#60A5FA" FontSize="11"
                                           FontFamily="Segoe UI" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Foreground="#D1D5DB" FontSize="13" FontFamily="Segoe UI"
                                       TextWrapping="Wrap">
                                Hi! I'm your AI productivity coach. Ask me about your focus patterns,
                                how to improve your work habits, or anything about your sessions.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <!-- Coach message (left) -->
                                    <Border HorizontalAlignment="Left" MaxWidth="360"
                                            Background="#0F3B82F6" CornerRadius="12,12,12,4"
                                            Padding="12,8" Visibility="{Binding CoachVisibility}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="20" Height="20" CornerRadius="10"
                                                        Background="#3B82F6" Margin="0,0,6,0">
                                                    <TextBlock Text="✨" FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Coach" Foreground="#60A5FA"
                                                           FontSize="11" FontFamily="Segoe UI"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="#D1D5DB"
                                                       FontSize="13" FontFamily="Segoe UI"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- User message (right) -->
                                    <Border HorizontalAlignment="Right" MaxWidth="320"
                                            Background="#1F3B82F6" CornerRadius="12,12,4,12"
                                            Padding="12,8" Visibility="{Binding UserVisibility}">
                                        <TextBlock Text="{Binding Text}" Foreground="White"
                                                   FontSize="13" FontFamily="Segoe UI"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Input area -->
            <Border Grid.Row="2" Background="#0A000000" CornerRadius="0,0,20,20"
                    Margin="1,0,1,1" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Text input + buttons -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox" Grid.Column="0"
                                 Background="#1F2937" Foreground="White"
                                 BorderBrush="#374151" BorderThickness="1"
                                 FontFamily="Segoe UI" FontSize="13"
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Height="38" Margin="0,0,6,0"
                                 KeyDown="InputBox_KeyDown"/>

                        <Button x:Name="StopBtn" Grid.Column="1"
                                Content="⏹ Stop" Height="38"
                                Style="{StaticResource StopBtnStyle}"
                                Padding="8,0"
                                Click="StopButton_Click"
                                Visibility="Collapsed"/>

                        <Button x:Name="SendBtn" Grid.Column="3"
                                Content="Send" Height="38"
                                Style="{StaticResource SendBtnStyle}"
                                Padding="8,0"
                                Click="SendButton_Click"/>
                    </Grid>

                    <!-- Status row -->
                    <TextBlock x:Name="StatusText" Grid.Row="1"
                               Foreground="#4B5563" FontSize="11" FontFamily="Segoe UI"
                               Margin="0,6,0,0" Visibility="Collapsed"/>

                    <!-- Report row -->
                    <TextBlock Grid.Row="2" Margin="0,6,0,0" HorizontalAlignment="Right">
                        <Hyperlink Click="ReportContent_Click"
                                   Foreground="#4B5563"
                                   TextDecorations="None">
                            <Run Text="⚑ Report inappropriate content"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
