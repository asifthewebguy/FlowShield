<Window x:Class="FlowShield.Desktop.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="480" Height="260"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="#0f172a" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="32" Opacity="0.65" ShadowDepth="10" Direction="270" />
        </Border.Effect>

        <Grid Margin="40,32,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo + Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Logo -->
                <Image x:Name="LogoImage"
                       Width="76" Height="76"
                       Margin="0,0,24,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Text -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FlowShield"
                               FontFamily="Segoe UI"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="White"
                               TextOptions.TextFormattingMode="Display" />
                    <TextBlock Text="Master Your Focus."
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="2,6,0,0" />
                    <TextBlock Text="Amplify Your Output."
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0ea5e9"
                               Margin="2,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Bottom bar: status + version -->
            <Grid Grid.Row="1" Margin="0,20,0,0">

                <!-- Animated loading dots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="Starting up"
                               Foreground="#64748b"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="#0ea5e9" VerticalAlignment="Center" Margin="2,0" />
                    <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="#0ea5e9" VerticalAlignment="Center" Margin="2,0" Opacity="0.4" />
                    <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="#0ea5e9" VerticalAlignment="Center" Margin="2,0" Opacity="0.15" />
                </StackPanel>

                <!-- Version -->
                <TextBlock x:Name="VersionText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#334155"
                           FontFamily="Segoe UI"
                           FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
