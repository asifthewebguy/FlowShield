<Window x:Class="FlowShield.Desktop.UI.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowShield Analytics"
        Width="700" Height="560"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#111827"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Period tab button — inactive state -->
        <Style x:Key="PeriodTabStyle" TargetType="Button">
            <Setter Property="Background"   Value="#1AFFFFFF"/>
            <Setter Property="Foreground"   Value="#9CA3AF"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Height"       Value="28"/>
            <Setter Property="Padding"      Value="14,0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active period tab -->
        <Style x:Key="PeriodTabActiveStyle" BasedOn="{StaticResource PeriodTabStyle}" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Small icon button (refresh, close) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat card -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background"   Value="#0FFFFFFF"/>
            <Setter Property="Padding"      Value="16,12"/>
        </Style>
    </Window.Resources>

    <!-- Outer shell — rounded, dark, drop shadow -->
    <Border CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F2937" Offset="0.0"/>
                <GradientStop Color="#111827" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>    <!-- header -->
                <RowDefinition Height="Auto"/>   <!-- stat cards -->
                <RowDefinition Height="*"/>      <!-- chart + sessions -->
                <RowDefinition Height="32"/>     <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- ══════════════════ HEADER ══════════════════ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow">
                <Grid Margin="20,0">
                    <!-- Left: title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analytics"
                                   Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Centre: period tabs -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnWeek"  Content="Week"  Tag="week"
                                Style="{StaticResource PeriodTabActiveStyle}"
                                Click="PeriodButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="BtnMonth" Content="Month" Tag="month"
                                Style="{StaticResource PeriodTabStyle}"
                                Click="PeriodButton_Click"/>
                    </StackPanel>

                    <!-- Right: refresh + close -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RefreshBtn" Content="↻"
                                Width="32" Height="32"
                                Style="{StaticResource IconButtonStyle}"
                                Click="RefreshButton_Click"
                                Margin="0,0,6,0"
                                ToolTip="Refresh"/>
                        <Button Content="✕"
                                Width="32" Height="32"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Divider -->
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                       Fill="#1AFFFFFF" Margin="20,0"/>

            <!-- ══════════════════ STAT CARDS ══════════════════ -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="20,16,20,0">

                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Focus Time" Foreground="#9CA3AF" FontSize="11" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TotalFocusText"
                                   Text="--" Foreground="White"
                                   FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="total" Foreground="#6B7280" FontSize="11" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Sessions" Foreground="#9CA3AF" FontSize="11" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="SessionsText"
                                   Text="--" Foreground="White"
                                   FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="done / total" Foreground="#6B7280" FontSize="11" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Completion" Foreground="#9CA3AF" FontSize="11" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="CompletionText"
                                   Text="--" Foreground="#10B981"
                                   FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="rate" Foreground="#6B7280" FontSize="11" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Peak Time" Foreground="#9CA3AF" FontSize="11" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="PeakText"
                                   Text="--" Foreground="#F59E0B"
                                   FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="most productive" Foreground="#6B7280" FontSize="11" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ══════════════════ CHART + SESSIONS ══════════════════ -->
            <Grid Grid.Row="2" Margin="20,20,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>

                <!-- Daily bar chart -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Daily Focus Time"
                               Foreground="#9CA3AF" FontSize="12" FontFamily="Segoe UI"
                               FontWeight="Medium" Margin="0,0,0,10"/>

                    <!-- Loading indicator -->
                    <TextBlock x:Name="LoadingText" Text="Loading…"
                               Foreground="#4B5563" FontSize="12" FontFamily="Segoe UI"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="BarsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7" Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Day label -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Day}"
                                               Foreground="#6B7280" FontSize="11"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>

                                    <!-- Track (background) -->
                                    <Border Grid.Column="1" CornerRadius="4"
                                            Background="#1AFFFFFF" Height="16"
                                            VerticalAlignment="Center">
                                        <!-- Fill bar — Width pre-calculated in ViewModel -->
                                        <Border CornerRadius="4" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}" Height="16">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#2563EB" Offset="0"/>
                                                    <GradientStop Color="#60A5FA" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <!-- Minutes label -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Minutes}"
                                               Foreground="#6B7280" FontSize="10"
                                               FontFamily="Segoe UI"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Recent sessions list -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Recent Sessions"
                               Foreground="#9CA3AF" FontSize="12" FontFamily="Segoe UI"
                               FontWeight="Medium" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="SessionsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" CornerRadius="8"
                                        Background="#0FFFFFFF" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Date}"
                                                       Foreground="White" FontSize="11"
                                                       FontFamily="Segoe UI" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Type}"
                                                       Foreground="#6B7280" FontSize="10"
                                                       FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Duration}"
                                                       Foreground="#9CA3AF" FontSize="11"
                                                       FontFamily="Segoe UI" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="10" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- ══════════════════ STATUS BAR ══════════════════ -->
            <Border Grid.Row="3" CornerRadius="0,0,20,20" Margin="1,0,1,1"
                    Background="#0A000000">
                <TextBlock x:Name="LastUpdatedText"
                           Text="—"
                           Foreground="#4B5563" FontSize="11" FontFamily="Segoe UI"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,20,0"/>
            </Border>

        </Grid>
    </Border>
</Window>
