<Window x:Class="FlowShield.Desktop.UI.TeamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowShield Teams"
        Width="520" Height="600"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#111827"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Icon button (close) -->
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action button (join) -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style matching dark theme -->
        <Style x:Key="DarkInputStyle" TargetType="TextBox">
            <Setter Property="Background"              Value="#1F2937"/>
            <Setter Property="Foreground"              Value="White"/>
            <Setter Property="BorderBrush"             Value="#374151"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="Height"                  Value="36"/>
            <Setter Property="CaretBrush"              Value="White"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F2937" Offset="0"/>
                <GradientStop Color="#111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="My Teams" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Width="32" Height="32"
                            Style="{StaticResource IconBtnStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="#1AFFFFFF" Margin="20,0"/>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,16,20,16">
                <StackPanel>

                    <!-- ── Create Team ── -->
                    <Border Background="#0F3B82F6" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Create a Team" Foreground="#93C5FD" FontSize="13"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CreateNameBox" Grid.Column="0"
                                         Style="{StaticResource DarkInputStyle}"
                                         KeyDown="CreateNameBox_KeyDown"/>
                                <Button x:Name="CreateBtn" Grid.Column="2"
                                        Content="Create" Height="36"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        Padding="8,0"
                                        Click="CreateButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="CreateStatusText" Foreground="#EF4444" FontSize="11"
                                       FontFamily="Segoe UI" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Join Team ── -->
                    <Border Background="#0A000000" CornerRadius="12" Padding="14,12" Margin="0,0,0,16"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Join a Team" Foreground="#9CA3AF" FontSize="13"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InviteCodeBox" Grid.Column="0"
                                         Style="{StaticResource DarkInputStyle}"
                                         KeyDown="InviteCodeBox_KeyDown"/>
                                <Button x:Name="JoinBtn" Grid.Column="2"
                                        Content="Join" Height="36"
                                        Style="{StaticResource SecondaryBtnStyle}"
                                        Padding="8,0"
                                        Click="JoinButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="JoinStatusText" Foreground="#EF4444" FontSize="11"
                                       FontFamily="Segoe UI" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Section header ── -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Your Teams" Foreground="#6B7280" FontSize="11"
                                   FontFamily="Segoe UI" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Loading / empty states -->
                    <TextBlock x:Name="LoadingText" Text="Loading teams…" Foreground="#4B5563"
                               FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,20" Visibility="Visible"/>
                    <TextBlock x:Name="EmptyText" Text="You're not in any team yet."
                               Foreground="#4B5563" FontSize="13" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>

                    <!-- Team list -->
                    <ItemsControl x:Name="TeamsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBackground}" CornerRadius="10"
                                        Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: name + stats -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" Foreground="White"
                                                           FontSize="14" FontFamily="Segoe UI"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Background="{Binding RoleBadgeBackground}"
                                                        CornerRadius="4" Padding="5,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RoleText}"
                                                               Foreground="{Binding RoleBadgeForeground}"
                                                               FontSize="10" FontFamily="Segoe UI"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MemberText}" Foreground="#6B7280"
                                                       FontSize="11" FontFamily="Segoe UI"/>
                                            <TextBlock Text="{Binding InviteCodeText}"
                                                       Foreground="#4B5563" FontSize="11"
                                                       FontFamily="Segoe UI Mono"
                                                       Visibility="{Binding InviteCodeVisibility}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
