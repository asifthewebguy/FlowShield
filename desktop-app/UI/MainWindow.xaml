<Window x:Class="FlowShield.Desktop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlowShield Widget" 
        Height="400" Width="320"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#111827"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Modern Button Style Template -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}" 
                                                  Direction="270"
                                                  ShadowDepth="2" 
                                                  BlurRadius="10" 
                                                  Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}" 
                                              Content="{TemplateBinding Content}" 
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" 
                                              Focusable="False" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                             To="1.05" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                             To="1.05" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                             To="0.95" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="border" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                             To="0.95" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Gradient -->
    <Border CornerRadius="24" 
            BorderBrush="#33FFFFFF" 
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F2937" Offset="0.0"/>
                <GradientStop Color="#111827" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drag Handle / Header -->
            <Border Grid.Row="0" Background="Transparent" Height="50" MouseLeftButtonDown="DragWindow">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon Placeholder (e.g. Emoji or Path) -->
                        <TextBlock Text="⚡" Margin="0,0,8,0" Foreground="#60A5FA" FontSize="14"/>
                        <TextBlock Text="FlowShield" 
                                   Foreground="White" 
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Opacity="0.9"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Glowing Timer Pulse Effect -->
                <Border x:Name="TimerGlow" 
                        Background="Transparent" 
                        CornerRadius="50" 
                        Width="200" Height="200" 
                        Margin="0,-40,0,0"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <BlurEffect Radius="40"/>
                    </Border.Effect>
                </Border>

                <TextBlock x:Name="TimerText"
                           Text="25:00" 
                           Foreground="White" 
                           FontSize="64" 
                           FontFamily="Segoe UI"
                           FontWeight="Thin"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <Border x:Name="SessionTypeBadge"
                        Background="#1A3B82F6"
                        CornerRadius="8"
                        Padding="10,3"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SessionTypeText"
                               Text="💼 Work"
                               Foreground="#60A5FA"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"/>
                </Border>

                <TextBlock x:Name="StatusText"
                           Text="Ready to Focus"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Controls -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,30">
                
                <!-- Blocking Toggle -->
                <CheckBox x:Name="BlockingToggle" 
                          Content="Deep Work Mode"
                          Foreground="#9CA3AF"
                          FontSize="12"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,15"
                          Checked="BlockingToggle_Checked"
                          Unchecked="BlockingToggle_Unchecked">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                    </CheckBox.LayoutTransform>
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                                            <Border x:Name="toggleBorder" 
                                                    Width="36" Height="20" 
                                                    CornerRadius="10" 
                                                    Background="#374151" 
                                                    Margin="0,0,8,0">
                                                <Ellipse x:Name="toggleButton" 
                                                         Width="16" Height="16" 
                                                         Fill="White" 
                                                         HorizontalAlignment="Left" 
                                                         Margin="2,0,0,0"/>
                                            </Border>
                                            <TextBlock x:Name="text" 
                                                       Text="{TemplateBinding Content}" 
                                                       Foreground="{TemplateBinding Foreground}" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="toggleBorder" Property="Background" Value="#10B981"/> <!-- Green-500 -->
                                                <Setter TargetName="toggleButton" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="toggleButton" Property="Margin" Value="0,0,2,0"/>
                                                <Setter TargetName="text" Property="Foreground" Value="#10B981"/>
                                                <Setter TargetName="text" Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton"
                            Content="Start Session" 
                            Width="140" 
                            Height="44"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="StartToggle_Click"
                            Margin="0,0,12,0"/>
                    
                    <Button Content="Close" 
                            Width="80" 
                            Height="44"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
