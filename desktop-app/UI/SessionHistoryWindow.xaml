<Window x:Class="FlowShield.Desktop.UI.SessionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowShield Session History"
        Width="540" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RefreshBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F2937" Offset="0"/>
                <GradientStop Color="#111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Session History" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RefreshBtn" Content="↻ Refresh" Height="28"
                                Style="{StaticResource RefreshBtnStyle}"
                                Padding="10,0" Margin="0,0,8,0"
                                Click="RefreshButton_Click"/>
                        <Button Content="✕" Width="32" Height="32"
                                Style="{StaticResource IconBtnStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="#1AFFFFFF" Margin="20,0"/>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Grid Grid.Row="0" Margin="20,12,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DATE" Foreground="#4B5563" FontSize="10"
                               FontFamily="Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="PLANNED" Foreground="#4B5563" FontSize="10"
                               FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="ACTUAL" Foreground="#4B5563" FontSize="10"
                               FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="STATUS" Foreground="#4B5563" FontSize="10"
                               FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Grid>
                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                           Fill="#1AFFFFFF" Margin="20,0"/>

                <!-- Session list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,8,20,16">
                    <StackPanel>
                        <TextBlock x:Name="LoadingText" Text="Loading history…" Foreground="#4B5563"
                                   FontSize="13" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" Margin="0,24"
                                   Visibility="Visible"/>
                        <TextBlock x:Name="EmptyText" Text="No sessions found."
                                   Foreground="#4B5563" FontSize="13" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" Margin="0,24"
                                   Visibility="Collapsed"/>

                        <ItemsControl x:Name="SessionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A000000" CornerRadius="8"
                                            Padding="12,10" Margin="0,0,0,4"
                                            BorderBrush="#0FFFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Date + type -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DateText}" Foreground="White"
                                                           FontSize="13" FontFamily="Segoe UI"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TypeText}" Foreground="#6B7280"
                                                           FontSize="11" FontFamily="Segoe UI"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Planned duration -->
                                            <TextBlock Grid.Column="1" Text="{Binding PlannedText}"
                                                       Foreground="#9CA3AF" FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <!-- Actual duration -->
                                            <TextBlock Grid.Column="2" Text="{Binding ActualText}"
                                                       Foreground="#9CA3AF" FontSize="12"
                                                       FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <!-- Status badge -->
                                            <Border Grid.Column="3" Background="{Binding StatusBackground}"
                                                    CornerRadius="6" Padding="8,3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding StatusForeground}"
                                                           FontSize="10" FontFamily="Segoe UI"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
